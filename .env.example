# Neon Postgres connection string (use the pooled one from the Neon dashboard)
DATABASE_URL=""

# Random string, 32+ chars, used to sign login cookies.  Generate: openssl rand -base64 48
AUTH_SECRET=""

# Used only by `npm run db:seed`
SEED_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_SAMPLE_DATA=""

# Image upload to Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
